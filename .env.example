# --- PayPal (sandbox only) -------------------------------------------------
# Create a sandbox REST app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox = real calls to the PayPal sandbox through the PayPal Agent Toolkit
# mock    = no PayPal call; payments are labelled "Simulated" in the UI
# Defaults to sandbox when credentials are present, otherwise mock.
PAYPAL_MODE=

# Optional: a sandbox billing agreement id (B-...) that a sandbox buyer approved
# for this app. With it, purchases under the auto-pay limit are captured at once.
PAYPAL_AUTOPAY_AGREEMENT_ID=

# Optional: id of a PayPal webhook that points at
#   <PUBLIC_ORIGIN>/intentchain/api/paypal/webhook
# Deliveries are applied only after PayPal verifies their signature.
PAYPAL_WEBHOOK_ID=

# Public origin used to build the PayPal return URL, e.g. https://demo.jxdtw.com
# Leave empty to derive it from the incoming request.
PUBLIC_ORIGIN=

# --- AI (intent analysis) ---------------------------------------------------
# JEV / TypeSafe System One. Without a key the app uses the bundled reference
# scores and labels every AI result as "cached".
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_TIMEOUT=8
# Cost guard for the public demo
AI_MAX_CALLS_PER_SESSION=60
AI_MAX_CALLS_PER_DAY=2000

# --- App --------------------------------------------------------------------
DEMO_MODE=true
DATABASE_PATH=./data/intentchain.db
